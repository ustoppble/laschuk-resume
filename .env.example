# Copy to .env and fill in. Quote any value that contains spaces.

# --- Evolution API v2 (required) ---
EVOLUTION_URL=                # e.g. https://evolution.your-domain.com (no trailing path)
EVOLUTION_INSTANCE=           # instance name as shown in Evolution
EVOLUTION_API_KEY=            # instance token or global API key (sent as the `apikey` header)

# --- Target group ---
GROUP_NAME="Meu Grupo"        # resolved to a JID at startup via /group/fetchAllGroups
GROUP_JID=                    # optional: set (e.g. 1203630...@g.us) to skip the name lookup
GROUP_REACTIONS=1             # react on the group audio: ⏳ processing, ✅ replied, ❌ failed (0 = off; DMs never)

# --- DM audio transcription (1x1 chats) ---
# Transcript + summary of audios received in DMs go ONLY to the owner's chat (or the target below), never to the sender.
DM_TRANSCRIBE=1               # 1 = on, 0 = off
OWNER_JID=                    # optional override; empty = resolved from the instance (ownerJid)
DM_TRANSCRIPT_TARGET_JID=     # optional: send DM transcripts to this chat/group JID instead of the owner chat; audios sent inside it are transcribed too

# --- Webhook protection (recommended) ---
# If set, requests must carry ?token=<value> or header `x-webhook-token: <value>`.
WEBHOOK_TOKEN=

# --- HTTP server ---
HOST=0.0.0.0
PORT=8787

# --- Transcription: auto | openai | local ---
# auto = OpenAI Whisper API when OPENAI_API_KEY is set, otherwise local faster-whisper.
TRANSCRIBER=auto
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=pt
# local faster-whisper (pip install -r requirements-local.txt, or LOCAL_WHISPER=1 for docker build)
LOCAL_WHISPER_MODEL=small     # tiny | base | small | medium | large-v3
LOCAL_WHISPER_DEVICE=cpu      # cpu | cuda
LOCAL_WHISPER_COMPUTE_TYPE=int8

# --- Summary: auto | anthropic | openai ---
# auto = Claude when ANTHROPIC_API_KEY/CLAUDE_API_KEY is set, otherwise OpenAI (needs OPENAI_SUMMARY_MODEL).
SUMMARIZER=auto
ANTHROPIC_API_KEY=            # or CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5   # Claude model for summaries (e.g. claude-haiku-5-5 = cheaper, claude-opus-5-5 = stronger)
OPENAI_SUMMARY_MODEL=         # required only when summarizing with OpenAI (no default)

# --- Behaviour / limits ---
# REPLY_PREFIX="🎧 *Resumo do áudio:*"   # empty string = no prefix line
MAX_AUDIO_SECONDS=1200        # skip longer audios (0 = no limit)
MAX_MESSAGE_AGE_SECONDS=900   # ignore backlog replayed after reconnects (0 = no limit)
MAX_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=120

# --- Daily digests (both OFF by default) ---
# Read from the message history Evolution already stores (/chat/findMessages): Evolution must keep message
# history (DATABASE_SAVE_DATA_NEW_MESSAGE=true). Nothing is sent while both switches below are 0.
# Preview any past day without sending:  python -m app.digest group --date 2026-11-24  (or: owner)
DIGEST_TIMEZONE=America/Sao_Paulo
DIGEST_CATCHUP_MINUTES=120    # after a restart/deploy, still send if this late past the scheduled time
# Group digest: only the top 3 highlights of the previous day (00:00-24:00), posted in the group with a real @mention of who
# started each one; never says anyone went unanswered.
DIGEST_GROUP_ENABLED=0
DIGEST_GROUP_JID=             # the group to summarize (…@g.us); the instance must be a member
DIGEST_GROUP_TIME=08:00       # HH:MM, every day (weekends included); a day without conversation sends nothing
# Owner digest: what is pending FOR THE OWNER from the previous day, across every chat of the owner's number
# (1x1 chats in full; in groups only mentions, replies/quotes of the owner, the owner's name or the owner speaking).
DIGEST_OWNER_ENABLED=0
DIGEST_OWNER_TIME=07:00
DIGEST_OWNER_INSTANCE=        # Evolution instance of the owner's number (same URL/key); empty = EVOLUTION_INSTANCE
DIGEST_OWNER_TARGET_JID=      # where it is sent; empty = the owner's own chat
DIGEST_OWNER_SCOPE=all        # all | dm | groups
DIGEST_OWNER_INCLUDE_JIDS=    # comma list: when set, ONLY these chats are read
DIGEST_OWNER_EXCLUDE_JIDS=    # comma list: chats never read (the own chat and DM_TRANSCRIPT_TARGET_JID never are)
# Model calls: message text per call (small = fits low rate-limit tiers such as 8k tokens/minute) and,
# for OpenAI-compatible reasoning models (e.g. gpt-oss on Groq), the reasoning effort ("low" saves tokens).
DIGEST_BATCH_CHARS=6000
DIGEST_REASONING_EFFORT=
# Model for the 2 daily digests only (e.g. openai/gpt-oss-20b on Groq, so they do not share the per-day token
# quota of the per-audio summaries). Empty = OPENAI_SUMMARY_MODEL. Per-audio summaries never use this.
DIGEST_MODEL=
# Optional: write the 2 daily digests with an agent CLI already logged in by OAuth (no API key).
# codex_cli = OpenAI Codex CLI logged in with ChatGPT, once, with `codex login --device-auth`. It runs as a plain
# text model: read-only sandbox, throwaway empty dir, no user config, no web search. Empty = the API path above.
DIGEST_PROVIDER=
DIGEST_CLI_MODEL=             # e.g. gpt-6-astra (the ChatGPT login does not accept every model)
# DIGEST_CLI_BIN=codex
# DIGEST_CLI_TIMEOUT_SECONDS=300
# DIGEST_DB=data/digest.sqlite3        # run markers + audio transcript cache
# DIGEST_RETENTION_HOURS=72            # cached transcripts are deleted after this

# --- Files ---
LOG_LEVEL=INFO
# LOG_FILE=logs/laschuk-resume.log
# DEDUPE_DB=data/seen.sqlite3
