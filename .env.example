# Copy to .env and fill in. Quote any value that contains spaces.

# --- Evolution API v2 (required) ---
EVOLUTION_URL=                # e.g. https://evolution.your-domain.com (no trailing path)
EVOLUTION_INSTANCE=           # instance name as shown in Evolution
EVOLUTION_API_KEY=            # instance token or global API key (sent as the `apikey` header)

# --- Target group ---
GROUP_NAME=Hillside           # resolved to a JID at startup via /group/fetchAllGroups
GROUP_JID=                    # optional: set (e.g. 1203630...@g.us) to skip the name lookup

# --- DM audio transcription (1x1 chats) ---
# Transcript + summary of audios received in DMs go ONLY to the owner's chat (or the target below), never to the sender.
DM_TRANSCRIBE=1               # 1 = on, 0 = off
OWNER_JID=                    # optional override; empty = resolved from the instance (ownerJid)
DM_TRANSCRIPT_TARGET_JID=     # optional: send DM transcripts to this chat/group JID instead of the owner chat

# --- Webhook protection (recommended) ---
# If set, requests must carry ?token=<value> or header `x-webhook-token: <value>`.
WEBHOOK_TOKEN=

# --- HTTP server ---
HOST=0.0.0.0
PORT=8787

# --- Transcription: auto | openai | local ---
# auto = OpenAI Whisper API when OPENAI_API_KEY is set, otherwise local faster-whisper.
TRANSCRIBER=auto
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
TRANSCRIBE_LANGUAGE=pt
# local faster-whisper (pip install -r requirements-local.txt, or LOCAL_WHISPER=1 for docker build)
LOCAL_WHISPER_MODEL=small     # tiny | base | small | medium | large-v3
LOCAL_WHISPER_DEVICE=cpu      # cpu | cuda
LOCAL_WHISPER_COMPUTE_TYPE=int8

# --- Summary: auto | anthropic | openai ---
# auto = Claude when ANTHROPIC_API_KEY/CLAUDE_API_KEY is set, otherwise OpenAI (needs OPENAI_SUMMARY_MODEL).
SUMMARIZER=auto
ANTHROPIC_API_KEY=            # or CLAUDE_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5   # Claude model for summaries (e.g. claude-haiku-5-5 = cheaper, claude-opus-5-5 = stronger)
OPENAI_SUMMARY_MODEL=         # required only when summarizing with OpenAI (no default)

# --- Behaviour / limits ---
# REPLY_PREFIX="🎧 *Resumo do áudio:*"   # empty string = no prefix line
MAX_AUDIO_SECONDS=1200        # skip longer audios (0 = no limit)
MAX_MESSAGE_AGE_SECONDS=900   # ignore backlog replayed after reconnects (0 = no limit)
MAX_CONCURRENCY=2
HTTP_TIMEOUT_SECONDS=120

# --- Files ---
LOG_LEVEL=INFO
# LOG_FILE=logs/laschuk-resume.log
# DEDUPE_DB=data/seen.sqlite3
